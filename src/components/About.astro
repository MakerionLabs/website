---
const stats = [
	{ value: "2026", label: "Founded" },
	{ value: "Wyoming, US", label: "Incorporated" },
	{ value: "Remote-first", label: "Team" },
];
---

<section id="about" class="mx-auto max-w-6xl px-6 py-24">
	<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
		<div>
			<h2 class="text-sm font-semibold tracking-widest text-[var(--color-brand-start)] uppercase">About us</h2>
			<p class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
				Makerion Labs is a small studio, built for shipping.
			</p>
			<p class="mt-6 leading-relaxed text-[var(--color-text-muted)]">
				We're a software studio operating as <strong class="text-[var(--color-text)]">Makerion LLC</strong>,
				building apps, browser extensions, and AI agents for clients and for ourselves. We favor small,
				focused teams, tight feedback loops, and shipping in public over long planning cycles.
			</p>
		</div>

		<dl class="grid grid-cols-1 gap-4 sm:grid-cols-3 lg:gap-4">
			{stats.map((stat) => (
				<div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6 text-center">
					<dt class="text-xl font-semibold brand-gradient-text">{stat.value}</dt>
					<dd class="mt-1 text-xs text-[var(--color-text-muted)]">{stat.label}</dd>
				</div>
			))}
		</dl>
	</div>
</section>
