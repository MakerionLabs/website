---
const products = [{ name: "Monobase", category: "Web App", status: "Coming soon" }];
---

<section id="products" class="border-t border-[var(--color-border)] bg-[var(--color-bg-elevated)]/40">
	<div class="mx-auto max-w-6xl px-6 py-24">
		<div class="max-w-2xl">
			<h2 class="text-sm font-semibold tracking-widest text-[var(--color-brand-start)] uppercase">Products</h2>
			<p class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
				A few things we're building in-house.
			</p>
		</div>

		<div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{products.map((product) => (
				<div class="flex max-w-sm flex-col justify-between rounded-2xl border border-dashed border-[var(--color-border)] bg-[var(--color-bg-card)]/60 p-6">
					<div>
						<span class="text-xs font-medium text-[var(--color-brand-start)]">{product.category}</span>
						<h3 class="mt-2 text-lg font-semibold">{product.name}</h3>
					</div>
					<span class="mt-6 inline-block w-fit rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-text-muted)]">
						{product.status}
					</span>
				</div>
			))}
		</div>
	</div>
</section>
