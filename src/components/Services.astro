<section id="services" class="mx-auto max-w-6xl px-6 py-24">
	<div class="max-w-2xl">
		<h2 class="text-sm font-semibold tracking-widest text-[var(--color-brand-start)] uppercase">What we build</h2>
		<p class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
			One team, four ways to ship your product.
		</p>
	</div>

	<div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
		{services.map((service) => (
			<div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6">
				<div class="flex h-11 w-11 items-center justify-center rounded-xl brand-gradient-bg">
					<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6" class="h-5 w-5">
						<path d={service.icon} stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</div>
				<h3 class="mt-5 text-base font-semibold">{service.title}</h3>
				<p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{service.description}</p>
			</div>
		))}
