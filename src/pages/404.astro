---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Page not found — Makerion Labs">
	<Header />
	<main class="mx-auto flex max-w-3xl flex-col items-center px-6 py-32 text-center">
		<span class="text-sm font-semibold tracking-widest text-[var(--color-brand-start)] uppercase">404</span>
		<h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">This page doesn't exist.</h1>
		<p class="mt-4 text-[var(--color-text-muted)]">The page you're looking for may have moved or been removed.</p>
		<a
			href="/"
			class="brand-gradient-bg mt-8 rounded-full px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-950/40 transition hover:brightness-110"
		>
			Back to homepage
		</a>
	</main>
	<Footer />
</Layout>
